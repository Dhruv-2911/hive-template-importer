# Copy to backend/.env.local for local development. Never commit real values.

# Postgres connection. Local: the docker compose database. Production: the Supabase session pooler URL
# (postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres?sslmode=require), see ADR-002.
DATABASE_URL=postgresql://hive:hive@localhost:5433/hive

# Sign-in (ADR-009). From your Supabase project: Project Settings → API Keys. Both values are public by design (the
# browser receives them from /api/auth/config), but keep them in your env file, not in code. The web app won't start
# without them; `python -m app.seed` doesn't need them.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Largest upload accepted, in megabytes.
MAX_UPLOAD_MB=10

# Development only: origins allowed to call the API from another port (Next.js dev server).
CORS_ORIGINS=http://localhost:3000
